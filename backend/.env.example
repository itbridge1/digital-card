PORT=5000
NODE_ENV=development
BASE_URL=http://localhost:5000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=DIGITAL_CARD
DB_USER=root
# Set this locally if your MySQL account requires a password.
DB_PASSWORD=

# Startup Sync Configuration
# Leave alter mode off unless you intentionally want Sequelize to reshape tables.
DB_SYNC_ON_START=true
DB_SYNC_ALTER=false

# JWT Configuration
JWT_SECRET=nfc-platform-secret-key-change-this-in-production
JWT_EXPIRE=30d
