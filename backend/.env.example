PORT=5000
NODE_ENV=development
BASE_URL=http://localhost:5000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nfc_platform
DB_USER=root
DB_PASSWORD=

# JWT Configuration
# REQUIRED: Generate a strong secret with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_BEFORE_DEPLOYING
JWT_EXPIRE=7d

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173
